generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum RoomStatus {
  ACTIVE
  ENDED
}
enum SourceType {
  COURSE_MATERIAL
  PAST_EXAM
}
model User {
  id String @id @default(cuid())
  email String @unique
  hashedPassword String?
  name String?
  emailVerified DateTime?
  image String? @db.Text
  accounts Account[]
  sessions Session[]
  createdAt DateTime @default(now())
  rooms Room[]
  participants Participant[]
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  expires_in Int?
  refresh_token_expires_in Int?
  ext_expires_in Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
model Room {
  id String @id @default(cuid())
  hostUserId String
  host User @relation(fields: [hostUserId], references: [id])
  name String
  studyFocusRaw String? @db.Text
  studyFocusBoost String[] @default([])
  studyFocusExclude String[] @default([])
  status RoomStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  endedAt DateTime?
  invitations RoomInvitation[]
  deliveries ReportDelivery[]
  documents Document[]
  participants Participant[]
  messages ChatMessage[]
  retrievalEvents RetrievalEvent[]
  questions QuizQuestion[]
  lostClicks LostClick[]
  summary SessionSummary?
}
model Document {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  filename String
  sourceType SourceType
  createdAt DateTime @default(now())
  chunks DocumentChunk[]
  rawText String? @db.Text
  processingVersion Int @default(1)
  @@index([roomId])
}
model DocumentChunk {
  id String @id @default(cuid())
  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content String @db.Text
  sectionLabel String?
  position Int
  active Boolean @default(true)
  embedding Unsupported("vector(384)")?
  createdAt DateTime @default(now())
  retrievalEvents RetrievalEvent[]
  questions QuizQuestion[]
  @@index([documentId, position])
}
model Participant {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id])
  displayName String
  email String?
  joinedAt DateTime @default(now())
  revokedAt DateTime?
  messages ChatMessage[]
  quizResults QuizResult[]
  lostClicks LostClick[]
  @@unique([roomId, userId])
}
model ChatMessage {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId String?
  participant Participant? @relation(fields: [participantId], references: [id])
  content String @db.Text
  citedChunkIds String[] @default([])
  citations Json?
  kind String @default("answer")
  status String @default("complete")
  createdAt DateTime @default(now())
  lostClicks LostClick[]
  @@index([roomId, createdAt])
  @@index([roomId, createdAt, id])
}
model RetrievalEvent {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  chunkId String
  chunk DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([roomId, createdAt])
}
model QuizQuestion {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sourceChunkId String
  sourceChunk DocumentChunk @relation(fields: [sourceChunkId], references: [id])
  questionText String
  options Json
  correctOptionIndex Int
  explanation String
  styledAfterPastExam Boolean @default(false)
  endsAt DateTime
  lockedAt DateTime?
  createdAt DateTime @default(now())
  results QuizResult[]
  @@index([roomId])
}
model QuizResult {
  id String @id @default(cuid())
  quizQuestionId String
  quizQuestion QuizQuestion @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
  participantId String
  participant Participant @relation(fields: [participantId], references: [id])
  submittedDistribution Json
  score Float
  zeroProbability Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([quizQuestionId, participantId])
}
model LostClick {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  chatMessageId String
  chatMessage ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  participantId String
  participant Participant @relation(fields: [participantId], references: [id])
  createdAt DateTime @default(now())
  @@unique([chatMessageId, participantId])
}
model SessionSummary {
  id String @id @default(cuid())
  roomId String @unique
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  resultJson Json
  createdAt DateTime @default(now())
}
model NewsletterSubscriber {
  id String @id @default(cuid())
  email String @unique
  unsubscribeToken String @unique
  createdAt DateTime @default(now())
  unsubscribedAt DateTime?
}

model GuardrailPolicy {
  id String @id
  config Json
  updatedAt DateTime @default(now()) @updatedAt
}
model GuardrailBucket {
  key String @id
  used Int
  expiresAt DateTime
  @@index([expiresAt])
}
model SecurityAudit {
  id String @id @default(cuid())
  action String
  actorId String?
  targetId String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model RoomInvitation {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}
model ReportDelivery {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId String
  status String @default("reserved")
  createdAt DateTime @default(now())
  @@unique([roomId, participantId])
}
model EmailVerification {
  tokenHash String @id
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model GuardrailLease {
  key String @id
  owner String
  expiresAt DateTime
}
