{
  "name": "study-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "server": "node --import tsx --import ./server/instrument.ts server/entry.mjs",
    "server:dev": "node --watch --import tsx --import ./server/instrument.ts server/entry.mjs",
    "server:build": "prisma generate && node scripts/build-realtime.mjs",
    "server:start": "node --import ./dist/realtime/instrument.mjs ./dist/realtime/entry.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "6.19.0",
    "@react-pdf/renderer": "^4.3.1",
    "@sentry/core": "11.4.0",
    "@sentry/nextjs": "11.4.0",
    "@sentry/node": "11.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xenova/transformers": "2.17.2",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "groq-sdk": "^0.37.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.24",
    "next-auth": "^4.24.11",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@sentry/cli": "3.8.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "postcss": "^8.5.23",
    "prisma": "6.19.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "sharp": "^0.35.4",
    "postcss": "^8.5.23",
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
