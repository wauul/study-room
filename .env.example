DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEXTAUTH_SECRET=
SOCKET_SIGNING_SECRET=
# Public widget key; secret is server-only. Missing config denies password signup/login.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional ONLY when an ingress strips client values and injects x-study-client-ip.
TRUSTED_PROXY_IP_HEADER=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
GITHUB_ID=
GITHUB_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
RESEND_API_KEY=
RESEND_FROM=Study Room <onboarding@resend.dev>
SOCKET_SERVER_URL=http://localhost:3001
APP_ORIGIN=http://localhost:3000
PORT=3001
HF_HOME=.cache/models

# Sentry: use the web project's DSN on Next.js and the realtime project's DSN on Render.
# Empty DSNs safely disable telemetry. These are public ingest identifiers, not upload tokens.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=study-room-iq
SENTRY_PROJECT=study-room-web
# Build-only secret. Prefer a CI secret; never put this in NEXT_PUBLIC_* or runtime secrets.
SENTRY_AUTH_TOKEN=
# Auto-derived from Git/VERCEL_GIT_COMMIT_SHA/RENDER_GIT_COMMIT at build time.
# Set the same study-room@<full commit SHA> explicitly for manual paired deployments.
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=development
# Browser release/environment are injected by next.config.mjs; do not set independently.
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Exact trusted origins, comma separated. Include the web and realtime hosts in deployments.
SENTRY_TRACE_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_SENTRY_TRACE_ORIGINS=http://localhost:3000,http://localhost:3001
# Logs accept only explicit fixed operation names. Console forwarding is disabled.
SENTRY_LOGS_ENABLED=false
NEXT_PUBLIC_SENTRY_LOGS_ENABLED=false
# Replay additionally requires a call to setReplayConsent(true) after explicit consent.
NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=false
# Profiling is intentionally unavailable until tested on these deployment runtimes.
SENTRY_PROFILES_SAMPLE_RATE=0
# Synthetic local/staging triggers; production always blocks them.
SENTRY_SMOKE_ENABLED=false
SENTRY_SMOKE_TOKEN=
